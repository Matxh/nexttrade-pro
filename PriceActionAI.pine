//@version=6
indicator("PriceAction AI | FULL SUITE", overlay=true, max_labels_count=500, max_boxes_count=500)

// ═════════════════════════════════════════════════════════════════════════════
// FULL INPUT MENU - Everything Toggleable
// ═════════════════════════════════════════════════════════════════════════════

// Main Features
grpMain = "🔥 Main Features"
showSessions = input.bool(true, "📊 Session Highs/Lows", group=grpMain)
showSR       = input.bool(true, "🎯 Support/Resistance", group=grpMain)
showOB       = input.bool(true, "🏦 Order Blocks", group=grpMain)
showFVG      = input.bool(true, "⚡ Fair Value Gaps", group=grpMain)
showSignals  = input.bool(true, "🚀 OMEGA Signals", group=grpMain)
showPanel    = input.bool(true, "📈 Info Panel", group=grpMain)

// Strategy Settings
grpStrat = "⚙️ Strategy Settings"
string htfTf    = input.timeframe("60", "Higher Timeframe", group=grpStrat)
float sens      = input.float(1.8, "OB Sensitivity (ATR Multiplier)", minval=1.0, step=0.1, group=grpStrat)
bool needTrend  = input.bool(true, "Require HTF Trend Align", group=grpStrat)
bool needVWAP   = input.bool(true, "Require VWAP Filter", group=grpStrat)
bool needVol    = input.bool(true, "Require Volume Climax", group=grpStrat)
int signalScore = input.int(3, "Signal Threshold (1-4)", minval=1, maxval=4, group=grpStrat)

// Session Toggles
grpSess = "🌍 Trading Sessions"
bool showAsia   = input.bool(true, "Asia (7PM-3AM EST)", group=grpSess)
bool showLondon = input.bool(true, "London (3AM-11AM EST)", group=grpSess)
bool showNY     = input.bool(true, "NY (9:30AM-4PM EST)", group=grpSess)

// Colors
grpColor = "🎨 Colors"
color colBull   = input.color(#00ffbb, "Bullish/Demand", group=grpColor)
color colBear   = input.color(#ff3355, "Bearish/Supply", group=grpColor)
color colAsia   = input.color(#5b9cf6, "Asia Session", group=grpColor)
color colLondon = input.color(#089981, "London Session", group=grpColor)
color colNY     = input.color(#f23645, "NY Session", group=grpColor)

// ═════════════════════════════════════════════════════════════════════════════
// CORE DATA - Global Scope (V6 Compliant)
// ═════════════════════════════════════════════════════════════════════════════

// Technicals
float atrVal      = ta.atr(14)
float vwapVal     = ta.vwap(close)
float ema20       = ta.ema(close, 20)
float ema50       = ta.ema(close, 50)

// HTF Data - MUST be global
float htfClose    = request.security(syminfo.tickerid, htfTf, close)
float htfEma      = request.security(syminfo.tickerid, htfTf, ta.ema(close, 20))
bool htfUp        = htfClose > htfEma

// Bools
bool aboveVwap    = close > vwapVal
bool volClimax    = volume > ta.ema(volume, 20) * 1.5
float bodySize    = math.abs(close - open)
bool isDispl      = bodySize > atrVal * sens and volClimax
bool isBullTrend  = htfUp and aboveVwap

// ═════════════════════════════════════════════════════════════════════════════
// SUPPORT & RESISTANCE (3 Lines)
// ═════════════════════════════════════════════════════════════════════════════

float pivotHigh = ta.pivothigh(high, 10, 10)
float pivotLow  = ta.pivotlow(low, 10, 10)

var line srLine1 = na
var line srLine2 = na
var line srLine3 = na
var int srAge1 = 0
var int srAge2 = 0
var int srAge3 = 0

srAge1 := srAge1 + 1
srAge2 := srAge2 + 1
srAge3 := srAge3 + 1

// Delete old S/R
if srAge1 > 100
    line.delete(srLine1)
    srLine1 := na
    srAge1 := 0

if srAge2 > 100
    line.delete(srLine2)
    srLine2 := na
    srAge2 := 0

if srAge3 > 100
    line.delete(srLine3)
    srLine3 := na
    srAge3 := 0

// Create new S/R from pivots
if showSR and not na(pivotHigh)
    if na(srLine1)
        srLine1 := line.new(bar_index - 10, pivotHigh, bar_index, pivotHigh, color=colBear, style=line.style_solid, width=2, extend=extend.right)
        srAge1 := 0
    else if na(srLine2)
        srLine2 := line.new(bar_index - 10, pivotHigh, bar_index, pivotHigh, color=colBear, style=line.style_solid, width=2, extend=extend.right)
        srAge2 := 0
    else if na(srLine3)
        srLine3 := line.new(bar_index - 10, pivotHigh, bar_index, pivotHigh, color=colBear, style=line.style_solid, width=2, extend=extend.right)
        srAge3 := 0
    else
        int oldest = srAge1 > srAge2 and srAge1 > srAge3 ? 1 : srAge2 > srAge3 ? 2 : 3
        if oldest == 1
            line.delete(srLine1)
            srLine1 := line.new(bar_index - 10, pivotHigh, bar_index, pivotHigh, color=colBear, style=line.style_solid, width=2, extend=extend.right)
            srAge1 := 0
        else if oldest == 2
            line.delete(srLine2)
            srLine2 := line.new(bar_index - 10, pivotHigh, bar_index, pivotHigh, color=colBear, style=line.style_solid, width=2, extend=extend.right)
            srAge2 := 0
        else
            line.delete(srLine3)
            srLine3 := line.new(bar_index - 10, pivotHigh, bar_index, pivotHigh, color=colBear, style=line.style_solid, width=2, extend=extend.right)
            srAge3 := 0

if showSR and not na(pivotLow)
    if na(srLine1)
        srLine1 := line.new(bar_index - 10, pivotLow, bar_index, pivotLow, color=colBull, style=line.style_solid, width=2, extend=extend.right)
        srAge1 := 0
    else if na(srLine2)
        srLine2 := line.new(bar_index - 10, pivotLow, bar_index, pivotLow, color=colBull, style=line.style_solid, width=2, extend=extend.right)
        srAge2 := 0
    else if na(srLine3)
        srLine3 := line.new(bar_index - 10, pivotLow, bar_index, pivotLow, color=colBull, style=line.style_solid, width=2, extend=extend.right)
        srAge3 := 0

// ═════════════════════════════════════════════════════════════════════════════
// SESSION HIGHS & LOWS (All 3 Sessions)
// ═════════════════════════════════════════════════════════════════════════════

bool inAsia   = not na(time(timeframe.period, "1900-0300", "America/New_York"))
bool inLondon = not na(time(timeframe.period, "0300-1100", "America/New_York"))
bool inNY     = not na(time(timeframe.period, "0930-1600", "America/New_York"))

// Asia Session
var float asiaHigh = na
var float asiaLow  = na
var box asiaBox    = na

if showSessions and showAsia and inAsia
    if na(asiaHigh)
        asiaHigh := high
        asiaLow  := low
        asiaBox  := box.new(bar_index, asiaHigh, bar_index, asiaLow, bgcolor=color.new(colAsia, 95), border_color=color.new(colAsia, 80), border_width=1)
    else
        asiaHigh := math.max(asiaHigh, high)
        asiaLow  := math.min(asiaLow, low)
        box.set_top(asiaBox, asiaHigh)
        box.set_bottom(asiaBox, asiaLow)
        box.set_right(asiaBox, bar_index)

if not inAsia and not na(asiaHigh)
    box.delete(asiaBox)
    asiaHigh := na
    asiaLow  := na
    asiaBox  := na

// London Session
var float ldnHigh = na
var float ldnLow  = na
var box ldnBox    = na

if showSessions and showLondon and inLondon
    if na(ldnHigh)
        ldnHigh := high
        ldnLow  := low
        ldnBox  := box.new(bar_index, ldnHigh, bar_index, ldnLow, bgcolor=color.new(colLondon, 95), border_color=color.new(colLondon, 80), border_width=1)
    else
        ldnHigh := math.max(ldnHigh, high)
        ldnLow  := math.min(ldnLow, low)
        box.set_top(ldnBox, ldnHigh)
        box.set_bottom(ldnBox, ldnLow)
        box.set_right(ldnBox, bar_index)

if not inLondon and not na(ldnHigh)
    box.delete(ldnBox)
    ldnHigh := na
    ldnLow  := na
    ldnBox  := na

// NY Session
var float nyHigh = na
var float nyLow  = na
var box nyBox    = na

if showSessions and showNY and inNY
    if na(nyHigh)
        nyHigh := high
        nyLow  := low
        nyBox  := box.new(bar_index, nyHigh, bar_index, nyLow, bgcolor=color.new(colNY, 95), border_color=color.new(colNY, 80), border_width=1)
    else
        nyHigh := math.max(nyHigh, high)
        nyLow  := math.min(nyLow, low)
        box.set_top(nyBox, nyHigh)
        box.set_bottom(nyBox, nyLow)
        box.set_right(nyBox, bar_index)

if not inNY and not na(nyHigh)
    box.delete(nyBox)
    nyHigh := na
    nyLow  := na
    nyBox  := na

// ═════════════════════════════════════════════════════════════════════════════
// FAIR VALUE GAPS (4-Box System)
// ═════════════════════════════════════════════════════════════════════════════

bool fvgBull = low > high[2] and close[1] > high[2]
bool fvgBear = high < low[2] and close[1] < low[2]

var box fvg1 = na
var box fvg2 = na
var box fvg3 = na
var box fvg4 = na

var int fvg1Age = 0
var int fvg2Age = 0
var int fvg3Age = 0
var int fvg4Age = 0

fvg1Age := fvg1Age + 1
fvg2Age := fvg2Age + 1
fvg3Age := fvg3Age + 1
fvg4Age := fvg4Age + 1

bool fvg1Mit = not na(fvg1) and ((low < box.get_bottom(fvg1)) or fvg1Age > 35)
bool fvg2Mit = not na(fvg2) and ((low < box.get_bottom(fvg2)) or fvg2Age > 35)
bool fvg3Mit = not na(fvg3) and ((high > box.get_top(fvg3)) or fvg3Age > 35)
bool fvg4Mit = not na(fvg4) and ((high > box.get_top(fvg4)) or fvg4Age > 35)

if fvg1Mit
    box.delete(fvg1)
    fvg1 := na
    fvg1Age := 0

if fvg2Mit
    box.delete(fvg2)
    fvg2 := na
    fvg2Age := 0

if fvg3Mit
    box.delete(fvg3)
    fvg3 := na
    fvg3Age := 0

if fvg4Mit
    box.delete(fvg4)
    fvg4 := na
    fvg4Age := 0

if showFVG and (fvgBull or fvgBear)
    color c = fvgBull ? colBull : colBear
    float top = fvgBull ? low : high[2]
    float bot = fvgBull ? high[2] : low

    if na(fvg1)
        fvg1 := box.new(bar_index-2, top, bar_index, bot, bgcolor=color.new(c, 90), border_color=color.new(c, 70), border_style=line.style_dotted)
        fvg1Age := 0
    else if na(fvg2)
        fvg2 := box.new(bar_index-2, top, bar_index, bot, bgcolor=color.new(c, 90), border_color=color.new(c, 70), border_style=line.style_dotted)
        fvg2Age := 0
    else if na(fvg3)
        fvg3 := box.new(bar_index-2, top, bar_index, bot, bgcolor=color.new(c, 90), border_color=color.new(c, 70), border_style=line.style_dotted)
        fvg3Age := 0
    else if na(fvg4)
        fvg4 := box.new(bar_index-2, top, bar_index, bot, bgcolor=color.new(c, 90), border_color=color.new(c, 70), border_style=line.style_dotted)
        fvg4Age := 0

if not na(fvg1)
    box.set_right(fvg1, bar_index)

if not na(fvg2)
    box.set_right(fvg2, bar_index)

if not na(fvg3)
    box.set_right(fvg3, bar_index)

if not na(fvg4)
    box.set_right(fvg4, bar_index)

// ═════════════════════════════════════════════════════════════════════════════
// ORDER BLOCKS (3-Box System)
// ═════════════════════════════════════════════════════════════════════════════

var box ob1 = na
var box ob2 = na
var box ob3 = na

var int ob1Age = 0
var int ob2Age = 0
var int ob3Age = 0

ob1Age := ob1Age + 1
ob2Age := ob2Age + 1
ob3Age := ob3Age + 1

if ob1Age > 25
    box.delete(ob1)
    ob1 := na
    ob1Age := 0

if ob2Age > 25
    box.delete(ob2)
    ob2 := na
    ob2Age := 0

if ob3Age > 25
    box.delete(ob3)
    ob3 := na
    ob3Age := 0

if showOB and isDispl
    color c = close > open ? colBull : colBear
    if na(ob1)
        ob1 := box.new(bar_index-1, high[1], bar_index, low[1], bgcolor=color.new(c, 88), border_color=color.new(c, 75), border_width=2)
        ob1Age := 0
    else if na(ob2)
        ob2 := box.new(bar_index-1, high[1], bar_index, low[1], bgcolor=color.new(c, 88), border_color=color.new(c, 75), border_width=2)
        ob2Age := 0
    else if na(ob3)
        ob3 := box.new(bar_index-1, high[1], bar_index, low[1], bgcolor=color.new(c, 88), border_color=color.new(c, 75), border_width=2)
        ob3Age := 0

if not na(ob1)
    box.set_right(ob1, bar_index)

if not na(ob2)
    box.set_right(ob2, bar_index)

if not na(ob3)
    box.set_right(ob3, bar_index)

// ═════════════════════════════════════════════════════════════════════════════
// OMEGA SCORING SYSTEM
// ═════════════════════════════════════════════════════════════════════════════

int scoreL = 0
int scoreS = 0

if aboveVwap or not needVWAP
    scoreL := scoreL + 1

if isDispl
    scoreL := scoreL + 1

if htfUp or not needTrend
    scoreL := scoreL + 1

if volClimax or not needVol
    scoreL := scoreL + 1

if not aboveVwap or not needVWAP
    scoreS := scoreS + 1

if isDispl
    scoreS := scoreS + 1

if not htfUp or not needTrend
    scoreS := scoreS + 1

if volClimax or not needVol
    scoreS := scoreS + 1

bool longSignal  = showSignals and scoreL >= signalScore and isDispl and close > open
bool shortSignal = showSignals and scoreS >= signalScore and isDispl and close < open

if longSignal
    label.new(bar_index, low, "▲" + str.tostring(scoreL), color=color.new(colBull, 20), textcolor=color.white, style=label.style_label_up, size=size.small)

if shortSignal
    label.new(bar_index, high, "▼" + str.tostring(scoreS), color=color.new(colBear, 20), textcolor=color.white, style=label.style_label_down, size=size.small)

// ═════════════════════════════════════════════════════════════════════════════
// INFO PANEL
// ═════════════════════════════════════════════════════════════════════════════

var table dash = table.new(position.top_right, 2, 4, bgcolor=#131722, border_color=#363a45, border_width=1)

if showPanel and barstate.islast
    table.cell(dash, 0, 0, "HTF Trend", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, htfUp ? "📈 BULL" : "📉 BEAR", bgcolor=htfUp ? colBull : colBear, text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 1, "VWAP", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, aboveVwap ? "ABOVE ✅" : "BELOW ❌", bgcolor=aboveVwap ? colBull : colBear, text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 2, "Session", text_color=color.white, text_size=size.small)
    string sessText = inNY ? "🔴 NY" : inLondon ? "🟢 London" : inAsia ? "🔵 Asia" : "⚪ None"
    table.cell(dash, 1, 2, sessText, text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 3, "Last Signal", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 3, longSignal ? "🟢 BUY" : shortSignal ? "🔴 SELL" : "⏳ WAIT", bgcolor=longSignal ? colBull : shortSignal ? colBear : #363a45, text_color=color.white, text_size=size.small)

// ═════════════════════════════════════════════════════════════════════════════
// BACKGROUND
// ═════════════════════════════════════════════════════════════════════════════

color bgColor = isBullTrend ? color.new(colBull, 98) : color.new(colBear, 98)
bgcolor(bgColor)
