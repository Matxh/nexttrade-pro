//@version=5
indicator("SMC All-In-One [NexTrade]", overlay=true, max_boxes_count=200, max_lines_count=200, max_labels_count=100)

// ═══════════════════════════════════════════════════
//  SETTINGS
// ═══════════════════════════════════════════════════
grp1 = "Order Blocks"
showOB      = input.bool(true, "Show Order Blocks", group=grp1)
obBullColor = input.color(color.new(#00c853, 85), "Bullish OB", group=grp1)
obBearColor = input.color(color.new(#ff1744, 85), "Bearish OB", group=grp1)
obMax       = input.int(3, "Max OBs shown", minval=1, maxval=8, group=grp1)

grp2 = "Fair Value Gaps"
showFVG     = input.bool(true, "Show FVGs", group=grp2)
fvgBullCol  = input.color(color.new(#00e5ff, 88), "Bullish FVG", group=grp2)
fvgBearCol  = input.color(color.new(#ff9100, 88), "Bearish FVG", group=grp2)
fvgMax      = input.int(3, "Max FVGs shown", minval=1, maxval=8, group=grp2)

grp3 = "BOS / CHOCH"
showBOS     = input.bool(true, "Show BOS & CHOCH", group=grp3)
bosCol      = input.color(color.new(#ffffff, 30), "BOS",   group=grp3)
chochCol    = input.color(color.new(#ffeb3b, 30), "CHOCH", group=grp3)
swingLen    = input.int(10, "Swing Length", minval=3, maxval=30, group=grp3)

grp4 = "ICT Killzones"
showKZ      = input.bool(true, "Show Killzones", group=grp4)
kzAsiaCol   = input.color(color.new(#9c27b0, 92), "Asia",     group=grp4)
kzLonCol    = input.color(color.new(#2196f3, 92), "London",   group=grp4)
kzNYCol     = input.color(color.new(#ff5722, 92), "New York", group=grp4)

grp5 = "Premium / Discount"
showPD      = input.bool(true, "Show Premium/Discount", group=grp5)
pdLen       = input.int(50, "Range Length", minval=20, group=grp5)

// ═══════════════════════════════════════════════════
//  1. ORDER BLOCKS — auto-delete when price closes through
// ═══════════════════════════════════════════════════
var box[] bullOBs     = array.new_box()
var float[] bullOBLow = array.new_float()
var box[] bearOBs     = array.new_box()
var float[] bearOBHi  = array.new_float()

if showOB
    // Create new OBs
    if close > high[2] and close[1] < open[1]
        b = box.new(bar_index-2, high[1], bar_index+40, low[1], border_color=color.new(#00c853,50), border_width=1, bgcolor=obBullColor)
        array.push(bullOBs, b)
        array.push(bullOBLow, low[1])
        if array.size(bullOBs) > obMax
            box.delete(array.shift(bullOBs))
            array.shift(bullOBLow)

    if close < low[2] and close[1] > open[1]
        b = box.new(bar_index-2, high[1], bar_index+40, low[1], border_color=color.new(#ff1744,50), border_width=1, bgcolor=obBearColor)
        array.push(bearOBs, b)
        array.push(bearOBHi, high[1])
        if array.size(bearOBs) > obMax
            box.delete(array.shift(bearOBs))
            array.shift(bearOBHi)

    // Extend and delete invalidated OBs
    int i = 0
    while i < array.size(bullOBs)
        box.set_right(array.get(bullOBs, i), bar_index + 2)
        if close < array.get(bullOBLow, i)
            box.delete(array.get(bullOBs, i))
            array.remove(bullOBs, i)
            array.remove(bullOBLow, i)
        else
            i += 1

    int j = 0
    while j < array.size(bearOBs)
        box.set_right(array.get(bearOBs, j), bar_index + 2)
        if close > array.get(bearOBHi, j)
            box.delete(array.get(bearOBs, j))
            array.remove(bearOBs, j)
            array.remove(bearOBHi, j)
        else
            j += 1

// ═══════════════════════════════════════════════════
//  2. FAIR VALUE GAPS — auto-delete when filled
// ═══════════════════════════════════════════════════
var box[] bullFVGs    = array.new_box()
var float[] bullFVGlo = array.new_float()
var box[] bearFVGs    = array.new_box()
var float[] bearFVGhi = array.new_float()

if showFVG
    if low > high[2]
        b = box.new(bar_index-2, low, bar_index+40, high[2], border_color=color.new(#00e5ff,60), border_width=1, bgcolor=fvgBullCol)
        array.push(bullFVGs, b)
        array.push(bullFVGlo, high[2])
        if array.size(bullFVGs) > fvgMax
            box.delete(array.shift(bullFVGs))
            array.shift(bullFVGlo)

    if high < low[2]
        b = box.new(bar_index-2, low[2], bar_index+40, high, border_color=color.new(#ff9100,60), border_width=1, bgcolor=fvgBearCol)
        array.push(bearFVGs, b)
        array.push(bearFVGhi, low[2])
        if array.size(bearFVGs) > fvgMax
            box.delete(array.shift(bearFVGs))
            array.shift(bearFVGhi)

    // Extend and delete filled FVGs
    int fi = 0
    while fi < array.size(bullFVGs)
        box.set_right(array.get(bullFVGs, fi), bar_index + 2)
        if close < array.get(bullFVGlo, fi)
            box.delete(array.get(bullFVGs, fi))
            array.remove(bullFVGs, fi)
            array.remove(bullFVGlo, fi)
        else
            fi += 1

    int fj = 0
    while fj < array.size(bearFVGs)
        box.set_right(array.get(bearFVGs, fj), bar_index + 2)
        if close > array.get(bearFVGhi, fj)
            box.delete(array.get(bearFVGs, fj))
            array.remove(bearFVGs, fj)
            array.remove(bearFVGhi, fj)
        else
            fj += 1

// ═══════════════════════════════════════════════════
//  3. BOS / CHOCH — only most recent
// ═══════════════════════════════════════════════════
var float lastSH  = na
var float lastSL  = na
var bool  bull    = true
var line  bosLine = na
var label bosLbl  = na

swingH = ta.pivothigh(high, swingLen, swingLen)
swingL = ta.pivotlow(low,  swingLen, swingLen)

if not na(swingH)
    lastSH := swingH
if not na(swingL)
    lastSL := swingL

if showBOS
    if bull and not na(lastSH) and close > lastSH
        if not na(bosLine)
            line.delete(bosLine)
        if not na(bosLbl)
            label.delete(bosLbl)
        bosLine := line.new(bar_index[swingLen], lastSH, bar_index, lastSH, color=bosCol, width=2)
        bosLbl  := label.new(bar_index, lastSH, "BOS", color=color.new(bosCol,100), textcolor=bosCol, style=label.style_label_down, size=size.small)

    if not bull and not na(lastSL) and close < lastSL
        if not na(bosLine)
            line.delete(bosLine)
        if not na(bosLbl)
            label.delete(bosLbl)
        bosLine := line.new(bar_index[swingLen], lastSL, bar_index, lastSL, color=bosCol, width=2)
        bosLbl  := label.new(bar_index, lastSL, "BOS", color=color.new(bosCol,100), textcolor=bosCol, style=label.style_label_up, size=size.small)

    if bull and not na(lastSL) and close < lastSL
        if not na(bosLine)
            line.delete(bosLine)
        if not na(bosLbl)
            label.delete(bosLbl)
        bosLine := line.new(bar_index[swingLen], lastSL, bar_index, lastSL, color=chochCol, style=line.style_dashed, width=2)
        bosLbl  := label.new(bar_index, lastSL, "CHOCH ▼", color=color.new(chochCol,100), textcolor=chochCol, style=label.style_label_up, size=size.small)
        bull := false

    if not bull and not na(lastSH) and close > lastSH
        if not na(bosLine)
            line.delete(bosLine)
        if not na(bosLbl)
            label.delete(bosLbl)
        bosLine := line.new(bar_index[swingLen], lastSH, bar_index, lastSH, color=chochCol, style=line.style_dashed, width=2)
        bosLbl  := label.new(bar_index, lastSH, "CHOCH ▲", color=color.new(chochCol,100), textcolor=chochCol, style=label.style_label_down, size=size.small)
        bull := true

// ═══════════════════════════════════════════════════
//  4. ICT KILLZONES — background only, no labels
// ═══════════════════════════════════════════════════
kzAsia = (hour(time,"UTC") >= 20) or (hour(time,"UTC") < 2)
kzLon  = hour(time,"UTC") >= 7  and hour(time,"UTC") < 10
kzNY   = hour(time,"UTC") >= 12 and hour(time,"UTC") < 15

bgcolor(showKZ and kzAsia ? kzAsiaCol : na, title="Asia")
bgcolor(showKZ and kzLon  ? kzLonCol  : na, title="London")
bgcolor(showKZ and kzNY   ? kzNYCol   : na, title="New York")

// ═══════════════════════════════════════════════════
//  5. PREMIUM / DISCOUNT
// ═══════════════════════════════════════════════════
rangeHi = ta.highest(high, pdLen)
rangeLo = ta.lowest(low,  pdLen)
rangeEQ = math.avg(rangeHi, rangeLo)

plot(showPD ? rangeEQ  : na, "EQ",         color=color.new(#ffffff,60), linewidth=1, style=plot.style_circles)
p1 = plot(showPD ? rangeHi : na, "High",   color=color.new(#ff1744,70), linewidth=1, style=plot.style_stepline)
p2 = plot(showPD ? rangeEQ : na, "EQ top", color=color.new(#ff1744,95), display=display.none)
p3 = plot(showPD ? rangeEQ : na, "EQ bot", color=color.new(#00c853,95), display=display.none)
p4 = plot(showPD ? rangeLo : na, "Low",    color=color.new(#00c853,70), linewidth=1, style=plot.style_stepline)

fill(p1, p2, color=color.new(#ff1744, 95), title="Premium")
fill(p3, p4, color=color.new(#00c853, 95), title="Discount")
